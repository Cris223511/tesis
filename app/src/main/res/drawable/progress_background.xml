<?xml version="1.0" encoding="utf-8"?>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="#1A1B2E"
                android:centerColor="#16213E"
                android:endColor="#0F3460"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="#2C3E50"/>
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <gradient
                    android:startColor="#3498DB"
                    android:centerColor="#2980B9"
                    android:endColor="#21618C"
                    android:angle="90"/>
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <gradient
                    android:startColor="#E74C3C"
                    android:centerColor="#E91E63"
                    android:endColor="#9C27B0"
                    android:angle="45"/>
                <stroke
                    android:width="0.5dp"
                    android:color="#FFFFFF"
                    android:dashWidth="4dp"
                    android:dashGap="2dp"/>
            </shape>
        </clip>
    </item>
</layer-list>