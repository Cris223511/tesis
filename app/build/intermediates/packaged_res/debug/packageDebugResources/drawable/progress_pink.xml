<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:startColor="#40FFB6C1"
                android:centerColor="#30FF69B4"
                android:endColor="#40FFB6C1"
                android:angle="90"/>
            <stroke
                android:width="1dp"
                android:color="#60FFFFFF"/>
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="24dp"/>
                        <gradient
                            android:startColor="#FF1493"
                            android:centerColor="#FF69B4"
                            android:endColor="#FF1493"
                            android:angle="0"/>
                    </shape>
                </item>

                <item
                    android:left="2dp"
                    android:right="2dp"
                    android:top="2dp"
                    android:bottom="2dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="22dp"/>
                        <gradient
                            android:startColor="#CCFF69B4"
                            android:centerColor="#EEFFB6C1"
                            android:endColor="#CCFF69B4"
                            android:angle="90"/>
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>