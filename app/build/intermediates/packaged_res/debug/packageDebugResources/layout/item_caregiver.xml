<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ripple Overlay for click effect -->
        <View
            android:id="@+id/rippleOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCaregiverPhoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <!-- Name -->
        <TextView
            android:id="@+id/tvCaregiverName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvCaregiverStatus"
            app:layout_constraintStart_toEndOf="@+id/ivCaregiverPhoto"
            app:layout_constraintTop_toTopOf="@+id/ivCaregiverPhoto"
            tools:text="Juan Pérez González" />

        <!-- Document -->
        <TextView
            android:id="@+id/tvCaregiverDocument"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tvCaregiverName"
            app:layout_constraintStart_toStartOf="@+id/tvCaregiverName"
            app:layout_constraintTop_toBottomOf="@+id/tvCaregiverName"
            tools:text="DNI: 12345678" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvCaregiverEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tvCaregiverName"
            app:layout_constraintStart_toStartOf="@+id/tvCaregiverName"
            app:layout_constraintTop_toBottomOf="@+id/tvCaregiverDocument"
            tools:text="juan@email.com" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvCaregiverStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_active_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Activo"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Gender and Phone Info -->
        <LinearLayout
            android:id="@+id/layoutCaregiverInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ivCaregiverPhoto"
            app:layout_constraintTop_toBottomOf="@+id/ivCaregiverPhoto">

            <TextView
                android:id="@+id/tvCaregiverGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_corner_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="M" />

            <TextView
                android:id="@+id/tvCaregiverPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="(+51) 987654321" />

        </LinearLayout>

        <!-- Patients Count Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPatientsCount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_child"
            app:iconGravity="start"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/layoutCaregiverInfo"
            app:layout_constraintTop_toBottomOf="@+id/layoutCaregiverInfo"
            app:rippleColor="@color/primary_light"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            tools:text="Por asignar" />

        <!-- Hidden TextView for compatibility -->
        <TextView
            android:id="@+id/tvPatientsCount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Last Access -->
        <TextView
            android:id="@+id/tvLastAccess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@+id/btnEditCaregiver"
            app:layout_constraintStart_toStartOf="@+id/btnPatientsCount"
            app:layout_constraintTop_toBottomOf="@+id/btnPatientsCount"
            tools:text="Último acceso: 15/03/2024" />

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/btnEditCaregiver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circular_button_background"
            android:src="@drawable/ic_edit"
            android:contentDescription="Editar cuidador"
            app:tint="@color/primary"
            app:layout_constraintEnd_toStartOf="@+id/btnViewPatients"
            app:layout_constraintTop_toTopOf="@+id/btnPatientsCount" />

        <!-- View Patients Button -->
        <ImageButton
            android:id="@+id/btnViewPatients"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/circular_button_background"
            android:src="@drawable/ic_child"
            android:contentDescription="Ver pacientes"
            app:tint="@color/accent"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteCaregiver"
            app:layout_constraintTop_toTopOf="@+id/btnPatientsCount" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDeleteCaregiver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circular_button_background"
            android:src="@drawable/ic_delete"
            android:contentDescription="Eliminar cuidador"
            app:tint="@color/error"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnPatientsCount" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>